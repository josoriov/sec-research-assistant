# Copy this file to `.env` and replace every value before starting the stack.
# `.env` is git-ignored: never commit real credentials.
#
#   cp .env.example .env
#
# These values are for local development only.

# --- PostgreSQL (pgvector image) ---
POSTGRES_USER=sec_admin
POSTGRES_PASSWORD=change-me-postgres-admin
POSTGRES_DB=sec_research
POSTGRES_PORT=5432

# --- Pipeline credentials: ingestion and dbt write bronze/silver/gold ---
PIPELINE_DB_USER=pipeline
PIPELINE_DB_PASSWORD=change-me-pipeline

# --- Read-only API credentials: published gold data only ---
GOLD_API_DB_USER=gold_api
GOLD_API_DB_PASSWORD=change-me-gold-api

# --- MinIO / S3-compatible object storage ---
# MinIO removed its public images from Docker Hub and Quay in 2025-2026, so the
# defaults use Chainguard's maintained builds. Override either image to pin a
# digest or use another registry.
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MINIO_CLIENT_IMAGE=cgr.dev/chainguard/minio-client:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=bronze
