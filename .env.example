# Copy this file to `.env` and replace every value before starting the stack.
# `.env` is git-ignored: never commit real credentials.
#
#   cp .env.example .env
#
# These values are for local development only.

# --- PostgreSQL (pgvector image) ---
POSTGRES_USER=sec_admin
POSTGRES_PASSWORD=change-me-postgres-admin
POSTGRES_DB=sec_research
POSTGRES_PORT=15432

# --- Pipeline credentials: ingestion and dbt write bronze/silver/gold ---
PIPELINE_DB_USER=pipeline
PIPELINE_DB_PASSWORD=change-me-pipeline

# --- Read-only API credentials: published gold data only ---
GOLD_API_DB_USER=gold_api
GOLD_API_DB_PASSWORD=change-me-gold-api

# --- MinIO / S3-compatible object storage ---
# Override either image to pin a digest or use another registry.
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MINIO_CLIENT_IMAGE=cgr.dev/chainguard/minio-client:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_BUCKET=bronze

# --- Host ports for the API and Airflow UI ---
API_PORT=18000
AIRFLOW_PORT=18080

# --- SEC EDGAR client identification ---
# SEC requires a descriptive User-Agent with contact details; requests without
# one may be blocked. Replace the contact with your own. Quote values that
# contain spaces so the file can also be sourced by a shell for dbt.
SEC_USER_AGENT="sec-research-assistant you@example.com"

# --- LLM API (task T006): OpenAI-compatible chat completions endpoint ---
# Answer composition is enabled only when LLM_MODEL is set together with either
# LLM_API_KEY (hosted provider) or an explicit LLM_BASE_URL (local server, no
# key). With LLM_MODEL unset, POST /answer returns the evidence package only and
# POST /ask (natural-language interpretation) returns an error status.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional: per-1K-token prices (USD) to record API cost; omit to log it as null.
# LLM_INPUT_COST_PER_1K=0.00015
# LLM_OUTPUT_COST_PER_1K=0.0006
