---
// Task T012: question form + clarification/correction flow. Submitting posts to
// the same-origin /api/ask server route (see src/pages/api/ask.ts), which
// proxies to the Python POST /ask endpoint. Task T013 renders the complete
// response: the cited answer, citations, calculations, passages, the interpreted
// request, and response metadata. All untrusted text is written with
// textContent, never innerHTML.
import { COMPANIES, METRICS } from '../lib/form.js';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SEC Research Assistant</title>
    <script is:inline>
      let savedTheme;
      try { savedTheme = localStorage.getItem('sec-research-theme'); } catch {}
      document.documentElement.dataset.theme = ['light', 'dark'].includes(savedTheme)
        ? savedTheme
        : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    </script>
    <style>
      :root {
        color-scheme: dark;
        --background: #101820;
        --surface: #182530;
        --input: #111c26;
        --text: #e7edf4;
        --muted: #a9bacb;
        --accent: #8ac7ff;
        --button-text: #10202e;
        --line: #3a4e62;
        --field-line: #61778c;
        --danger: #ffb4ab;
        --danger-line: #c87b7e;
        --danger-surface: #2f2128;
        --selection: #244b70;
      }
      :root[data-theme="light"] {
        color-scheme: light;
        --background: #f5f7fa;
        --surface: #ffffff;
        --input: #f8fafc;
        --text: #182b3d;
        --muted: #52677b;
        --accent: #245fa8;
        --button-text: #ffffff;
        --line: #d7e0e8;
        --field-line: #8193a5;
        --danger: #ab2939;
        --danger-line: #c86673;
        --danger-surface: #fff1f2;
        --selection: #d8e9fc;
      }
      * { box-sizing: border-box; }
      body {
        font: 16px/1.6 Arial, Helvetica, sans-serif;
        margin: 0;
        padding: 2.5rem 1rem;
        color: var(--text);
        background: var(--background);
      }
      main { width: min(48rem, 100%); min-width: 0; margin-inline: auto; }
      .page-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
      h1 { font-size: 1.6rem; letter-spacing: -0.02em; margin: 0; }
      .theme-control { display: flex; align-items: center; gap: 0.6rem; }
      .theme-control label { font-size: 0.875rem; color: var(--muted); }
      .intro { color: var(--muted); margin-block: 1rem 1.5rem; }
      form { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 0.25rem 1.25rem 1.25rem; }
      a { color: var(--accent); }
      a:focus-visible,
      button:focus-visible,
      select:focus-visible,
      textarea:focus-visible,
      summary:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
        border-radius: 3px;
      }
      ::selection { background: var(--selection); color: var(--text); }
      .field { margin-block: 1rem; display: flex; flex-direction: column; gap: 0.3rem; }
      label { font-weight: 600; }
      select, textarea, button { font: inherit; padding: 0.55rem 0.7rem; border-radius: 4px; }
      select, textarea { border: 1px solid var(--field-line); background: var(--input); color: var(--text); }
      select:hover, textarea:hover { border-color: var(--muted); }
      textarea { resize: vertical; }
      button {
        border: 1px solid var(--accent);
        background: var(--accent);
        color: var(--button-text);
        font-weight: 600;
        cursor: pointer;
        padding: 0.6rem 1.2rem;
      }
      button:hover:not([disabled]) { filter: brightness(1.08); }
      button[disabled] { opacity: 0.6; cursor: progress; }
      .secondary { border-color: var(--field-line); background: transparent; color: var(--text); font-weight: 400; font-size: 0.875rem; }
      .error { color: var(--danger); margin: 0; }
      #status { margin-block: 1rem 0; color: var(--muted); }
      #clarifications {
        border: 1px solid var(--danger-line);
        background: var(--danger-surface);
        border-radius: 4px;
        padding: 0.75rem 1rem 0.75rem 1.75rem;
        margin-block: 1rem;
      }
      #request-error {
        border-left: 4px solid var(--danger);
        background: var(--danger-surface);
        border-radius: 0 4px 4px 0;
        padding: 0.6rem 0.75rem;
      }
    </style>
    <!--
      Response styles are global (T013, F056): the response is built with
      document.createElement after hydration, and Astro scopes its regular
      styles to template elements. Every rule is contained under #results.
    -->
    <style is:global>
      #results { margin-block: 2.5rem; min-width: 0; }
      #results .results-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; border-bottom: 1px solid var(--line); padding-bottom: 0.75rem; }
      #results h2 { font-size: 1.3rem; letter-spacing: -0.02em; margin: 0; }
      #results #result-status { font-weight: 600; color: var(--muted); }
      #results #result-status[data-status="error"] { color: var(--danger); }
      #results #result-status[data-status="ok"] { color: var(--accent); }
      #results h3 { font-size: 1.1rem; margin-block: 1.75rem 0.5rem; }
      #results h4 { margin-block: 1rem 0.25rem; }
      #results dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.2rem 1rem;
        margin: 0.4rem 0;
      }
      #results dt { font-weight: 600; color: var(--muted); }
      #results dd { margin: 0; overflow-wrap: anywhere; }
      #results .answer-text, #results .passage-text { white-space: pre-wrap; }
      #results .answer-text { font-size: 1.05rem; }
      #results a, #results a:visited { color: var(--accent); }
      #results a { overflow-wrap: anywhere; }
      #results .citation-ref {
        vertical-align: super;
        font-size: 0.75em;
        font-weight: 600;
        line-height: 1.4;
        padding: 0 0.3em;
        border: 1px solid var(--line);
        border-radius: 4px;
        background: var(--input);
        text-decoration: none;
      }
      #results .citation-ref:hover { border-color: var(--accent); }
      #results a:focus-visible, #results summary:focus-visible, #results .citation:focus {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
      }
      #results .caveat, #results .no-answer {
        border-left: 4px solid var(--danger);
        background: var(--danger-surface);
        border-radius: 0 4px 4px 0;
        padding: 0.6rem 0.75rem;
        margin-block: 0.75rem;
      }
      #results .citation-list { padding-left: 1.5rem; }
      #results .citation {
        margin-block: 0.9rem;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 4px;
        padding: 0.6rem 0.75rem;
      }
      #results .citation-title { font-weight: 600; margin: 0 0 0.25rem; }
      #results .citation:target { border-color: var(--accent); }
      #results article { border-top: 1px solid var(--line); padding-top: 0.6rem; margin-top: 0.9rem; }
      #results article:first-of-type { border-top: 0; padding-top: 0; margin-top: 0; }
      #results details {
        margin-block: 0.6rem;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 4px;
        padding: 0.5rem 0.75rem;
      }
      #results summary { cursor: pointer; font-weight: 600; }
      #results pre {
        overflow-x: auto;
        max-width: 100%;
        padding: 0.6rem;
        background: var(--input);
        border: 1px solid var(--line);
        border-radius: 4px;
      }
    </style>
  </head>
  <body>
    <main>
      <header class="page-header">
        <h1>SEC Research Assistant</h1>
        <div class="theme-control">
          <label for="theme">Theme</label>
          <select id="theme" name="theme">
            <option value="light">Light</option>
            <option value="dark">Dark</option>
          </select>
        </div>
      </header>
      <p class="intro">
        Ask a question about a supported company's 10-K filings. The question is
        interpreted into a metric and fiscal years before the published data is
        queried.
      </p>

      <form id="ask-form" novalidate>
        <div class="field">
          <label for="company">Company</label>
          <select id="company" name="company" aria-describedby="company-error" required>
            <option value="">Select a company…</option>
            {COMPANIES.map((company) => <option value={company}>{company}</option>)}
          </select>
          <p class="error" id="company-error" hidden></p>
        </div>

        <div class="field">
          <label for="metric">Metric (optional)</label>
          <select id="metric" name="metric">
            <option value="">Let the assistant infer it</option>
            {METRICS.map((metric) => <option value={metric.value}>{metric.label}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="question">Question</label>
          <textarea id="question" name="question" rows="3"
            aria-describedby="question-error" required></textarea>
          <p class="error" id="question-error" hidden></p>
        </div>

        <button type="submit" id="submit">Ask</button>
      </form>

      <p id="status" role="status" aria-live="polite" hidden></p>
      <ul id="clarifications" aria-label="Clarifications needed" hidden></ul>
      <p id="request-error" role="alert" hidden></p>

      <section id="results" aria-labelledby="results-heading" hidden>
        <div class="results-header">
          <h2 id="results-heading">Response</h2>
          <button type="button" id="clear-response" class="secondary">Clear response</button>
        </div>
        <p id="result-status"></p>
        <div id="result-body"></div>
      </section>
    </main>

    <script>
      import { applyHttpResult, buildAskPayload, reducer } from '../lib/form.js';
      import { createRenderers } from '../lib/render.js';
      import { restoreSession, saveSession } from '../lib/session.js';

      let tabStorage;
      try { tabStorage = window.sessionStorage; } catch {}
      let state = restoreSession(tabStorage);

      const el = (id) => document.getElementById(id);
      const formEl = el('ask-form');
      const companyEl = el('company');
      const metricEl = el('metric');
      const questionEl = el('question');
      const submitEl = el('submit');
      const statusEl = el('status');
      const clarificationsEl = el('clarifications');
      const errorEl = el('request-error');
      const resultsEl = el('results');
      const resultStatusEl = el('result-status');
      const resultBodyEl = el('result-body');
      const clearEl = el('clear-response');
      const themeEl = el('theme');
      const fieldErrors = { company: el('company-error'), question: el('question-error') };
      let renderedResponse;

      const { renderResponse, renderStatus } = createRenderers(document);

      companyEl.value = state.company;
      metricEl.value = state.metric;
      questionEl.value = state.question;
      themeEl.value = document.documentElement.dataset.theme;
      themeEl.addEventListener('change', () => {
        document.documentElement.dataset.theme = themeEl.value;
        try { localStorage.setItem('sec-research-theme', themeEl.value); } catch {}
      });
      clearEl.addEventListener('click', () => {
        state = reducer(state, { type: 'clear_response' });
        saveSession(tabStorage, state);
        render();
        questionEl.focus();
      });

      function render() {
        submitEl.disabled = state.submitting;
        clearEl.disabled = state.submitting;
        submitEl.textContent = state.submitting ? 'Asking…' : 'Ask';

        statusEl.hidden = !state.submitting;
        statusEl.textContent = state.submitting
          ? 'Interpreting your question and retrieving evidence…'
          : '';

        for (const [field, element] of Object.entries(fieldErrors)) {
          const message = state.errors[field] ?? '';
          element.hidden = !message;
          element.textContent = message;
        }

        errorEl.hidden = !state.error;
        errorEl.textContent = state.error ?? '';

        clarificationsEl.hidden = state.clarifications.length === 0;
        clarificationsEl.replaceChildren(
          ...state.clarifications.map((item) => {
            const li = document.createElement('li');
            li.textContent = `${item.field}: ${item.reason}`;
            return li;
          }),
        );

        if (state.response !== renderedResponse) {
          renderedResponse = state.response;
          resultsEl.hidden = !state.response;
          if (state.response) {
            renderStatus(resultStatusEl, state.response);
            renderResponse(resultBodyEl, state.response);
          } else {
            resultStatusEl.textContent = '';
            resultBodyEl.replaceChildren();
          }
        }
      }

      for (const [field, input] of [
        ['company', companyEl],
        ['metric', metricEl],
        ['question', questionEl],
      ]) {
        input.addEventListener('input', () => {
          state = reducer(state, { type: 'edit', field, value: input.value });
          render();
        });
      }

      formEl.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (state.submitting) return; // duplicate-submit guard
        state = { ...state, company: companyEl.value, metric: metricEl.value, question: questionEl.value };

        const next = reducer(state, { type: 'submit' });
        const started = next.submitting && next !== state;
        state = next;
        render();
        if (!started) return;
        const submittedForm = state;

        try {
          const response = await fetch('/api/ask', {
            cache: 'no-store',
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(buildAskPayload(submittedForm)),
          });
          let body = null;
          try {
            body = await response.json();
          } catch {
            body = null; // a proxy/upstream error body that is not JSON
          }
          state = applyHttpResult(state, response, body);
          if (response.ok && state.response === body) {
            saveSession(tabStorage, { ...submittedForm, response: body });
          }
        } catch {
          state = reducer(state, { type: 'failure' });
        }
        render();
      });

      render();
    </script>
  </body>
</html>
