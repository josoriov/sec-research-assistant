# Archify working directory: local diagram sources, receipts, and browser evidence
.archify/

# Code editor files
.vscode/

# Local environment credentials: never commit real secrets
.env
.env.*
!.env.example
.venv/
.ruff_cache/

# Local implementation and review notes
.dev-notes/

# Python bytecode and test caches
__pycache__/
*.pyc
.pytest_cache/

# dbt build artifacts and local connection state
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml
