  "cards": [
    {
      "dot": "cyan",
      "title": "MVP scope",
      "items": [
        "5 companies · 3 years of 10-K filings",
        "Revenue · net income · operating cash flow",
        "No investment advice, real-time ingest, or autonomous SQL"
      ]
    },
    {
      "dot": "emerald",
      "title": "Governed evidence",
      "items": [
        "Resolve amendments, periods, units, and duplicates explicitly",
        "Retain accession, section, URL, hashes, and model version",
        "Treat document text as data; separate reports from inference"
      ]
    },
    {
      "dot": "amber",
      "title": "Operational proof",
      "items": [
        "Idempotent reruns · quarantine failures · historical backfills",
