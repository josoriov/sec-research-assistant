  "cards": [
    {
      "dot": "cyan",
      "title": "Question journey",
      "items": [
        "UI → same-origin proxy → /ask: infer metric and years, validate, query, compose.",
        "/answer accepts structured selections; without a model it returns evidence only.",
        "/ask requires a configured model; ambiguity requests clarification, provider errors stay explicit."
      ]
    },
    {
      "dot": "emerald",
      "title": "Data preparation and publication",
      "items": [
        "Bronze: MinIO holds original bytes; PostgreSQL holds manifests, facts and extracted blocks.",
        "Silver types and quarantines rows; CPU embeddings are reused by content and version.",
        "Gold uses tested candidates; Airflow publishes them in one transaction and restores API SELECT.",
        "Smoke ingestion is followed by this same DAG with skip_ingestion=true."
      ]
    },
    {
      "dot": "rose",
      "title": "Runtime and source boundaries",
      "items": [
        "Logical bronze/silver, candidate and served stores share one PostgreSQL + pgvector server.",
        "Pipeline jobs and publisher run in Airflow; the API has only gold credentials.",
        "The model sees prompts and selected evidence; citation IDs are checked against supplied sources.",
        "Source references use a verified local snapshot of the current uncommitted worktree."
      ]
    }
  ]
}
